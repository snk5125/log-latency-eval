# ── Terraform ────────────────────────────────────────────────
# State files contain account IDs, resource ARNs, and potentially secrets.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
# Real variable values (account IDs, AWS profiles). Commit only *.example.
terraform.tfvars
*.auto.tfvars
!*.tfvars.example
# Plan output files
*.tfplan
*.plan

# ── AWS / credentials ────────────────────────────────────────
.aws/
*.pem
*.key
*.p12
*.pfx
credentials
config.aws

# ── Ansible ──────────────────────────────────────────────────
*.retry
# Static inventories may embed hostnames/IPs of live infra. Dynamic
# inventory config (aws_ec2.yml) is safe and committed.
ansible/inventories/*.ini
ansible/inventories/host_vars/
ansible/inventories/group_vars/*secret*
# Rendered by scripts/gen-ansible-vars.sh from live Terraform outputs —
# contains account-specific resource identifiers. Commit only the .example.
ansible/inventories/group_vars/all/generated_infra.yml
vault-password*
.vault_pass*

# ── Cribl ────────────────────────────────────────────────────
# Auth tokens, licenses, and instance state must never be committed.
*.crbl
cribl-auth*
licenses/

# ── Harness / results data ───────────────────────────────────
# Raw run evidence can be large and contains live resource identifiers.
report/evidence/raw/
report/evidence/*.jsonl
report/evidence/*.csv.gz
# Per-run evidence directories (report/evidence/<run_id>/...) hold run/generator
# manifests and any other artifacts run_matrix.py/analyze.py write per run —
# live resource identifiers (bucket names, instance/host IDs) and raw counts,
# not source. Ignore all generated content under a run's evidence directory...
report/evidence/*/
# ...but keep the checked-in scaffolding files at the top level of evidence/
# (README.md documents the directory; .gitkeep, if present, holds the empty dir
# in git before any run has produced evidence).
!report/evidence/.gitkeep
!report/evidence/README.md
# Explicit manifest patterns (belt-and-suspenders with the directory-level
# ignore above, and correct even if a manifest is ever written directly under
# report/evidence/ rather than nested under a run_id subdirectory).
report/evidence/**/run-manifest.json
report/evidence/**/*.manifest.json
# analyze.py output tables/summary (written to report/evidence/ by default,
# PLAN §8 phase 4) — regenerated from live S3 data, not source.
latency_stats.csv
latency_stats.md
latency_summary.json
# run_matrix.py resumability state (report/evidence/run_matrix_state.json by
# default) — local orchestration progress, not source, and account/run-specific.
run_matrix_state.json
harness/**/__pycache__/
*.pyc
.venv/
venv/

# ── Editor / OS noise ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
