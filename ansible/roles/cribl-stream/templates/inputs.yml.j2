# {{ ansible_managed }}
# Cribl Stream standalone node inputs — tier {{ llt_role }}, scenario {{ scenario }}.
# Rendered directly to this node's own $CRIBL_HOME/local/cribl/inputs.yml — no
# leader, no groups/<g>/ tree, no commit/deploy (standalone, same file-config
# model as cribl-edge).
# MIRRORS vector-aggregator sources:
#   agg_t1: HTTP Raw :8080 (+ S3-via-SQS in S3/S4)
#   agg_t2: HTTP Raw :8081
inputs:
{% if llt_role == 'agg_t1' %}
  http_in:
    type: http_raw          # Cribl HTTP Raw == Vector http_server (PLAN §4.4)
    host: 0.0.0.0
    port: {{ cribl_t1_http_port }}
    tls:
      disabled: true         # TLS off on internal hops (PLAN §4.4)
    # NDJSON breaker so events get TOP-LEVEL run_id/seq/host_id/host_os/
    # t_gen_ns/hop_ts fields (analyze.py reads top-level fields) — without this,
    # the default breaker leaves the whole line in _raw and the Eval in
    # pipelines/stamp_agg can't see .hop_ts on the event.
    # LIVE-VERIFIED (Cribl 4.18.2): the built-in NDJSON ruleset ID is `Cribl`,
    # NOT the UI label "JSON Newline Delimited". With the wrong id the http_raw
    # source logs 'rulesets need creating: ["JSON Newline Delimited"]' and then
    # FAILS to process incoming POSTs (statusCode 500 / request hangs / client
    # times out) — this is what blocked the Cribl aggregator from ingesting the
    # Edge agent's forwarded events end-to-end. `Cribl` resolves cleanly.
    breakerRulesets:
      - "Cribl"
{% if scenario in ['s3', 's4'] %}
  s3_in:
    type: s3                 # S3 source == Vector aws_s3 source
    region: "{{ cribl_aws_region }}"
    # Event-driven pickup via SQS (PLAN §4.3), ENABLED ONLY in S3/S4.
    # LIVE-VERIFIED (cs-t1, Cribl 4.18.2): `queueName` ACCEPTS a full SQS URL —
    # the source parses it, logging `Creating SQS API instance ...
    # queueName:"llt-landing-cs-q" ... extractedRegion:"us-east-2"` (it extracts
    # the bare queue name + region from the URL). `started pollers count:3`
    # confirms the SQS consumer initialized cleanly against the landing queue.
    queueName: "{{ cribl_landing_sqs_url }}"
    # TUNING §4.6 item 4 — SQS long-poll wait raised to the 20 s ceiling
    # (cribl_s3_poll_timeout_secs, defaults/main.yml) — Cribl's own field is
    # "Poll timeout (secs)": min 1 / default 10 / max 20
    # (docs.cribl.io/stream/sources-s3/). 20 is AWS SQS's own hard max for
    # WaitTimeSeconds, matching PLAN §4.6.4's literal target value — this
    # minimizes empty-poll round trips, i.e. the closest available
    # approximation to "event-driven" pickup for a poll-based consumer.
    # Parity counterpart to Vector's sqs.poll_secs: 20
    # (vector-aggregator/templates/vector-agg.yaml.j2).
    # LIVE-VERIFIED (cs-t1, Cribl 4.18.2): `pollTimeoutSecs` is the correct key —
    # the s3_in input initializes with `pollTimeoutSecs:20` in its config echo
    # and no schema rejection (earlier TODO(verify) resolved).
    pollTimeoutSecs: {{ cribl_s3_poll_timeout_secs }}
    # Landing objects are full JSON NDJSON events — same breaker requirement
    # as http_in above (built-in ruleset id is `Cribl`, not the UI label).
    breakerRulesets:
      - "Cribl"
{% endif %}
{% else %}
  http_in:
    type: http_raw
    host: 0.0.0.0
    port: {{ cribl_t2_http_port }}
    tls:
      disabled: true
    # t2 receives the webhook forward from t1, which carries full JSON
    # events — same breaker requirement as t1's http_in (built-in ruleset id
    # is `Cribl`, not the UI label "JSON Newline Delimited").
    breakerRulesets:
      - "Cribl"
{% endif %}
