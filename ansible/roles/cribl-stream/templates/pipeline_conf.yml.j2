# {{ ansible_managed }}
# Cribl Stream standalone node pipeline "stamp_agg" — tier {{ llt_role }}.
# Rendered directly to this node's own $CRIBL_HOME/local/cribl/pipelines/
# stamp_agg/conf.yml — see inputs.yml.j2 note (no leader, no commit/deploy).
# FIELD NAMES are IDENTICAL to the Vector aggregator VRL remap and LOAD-BEARING
# for analysis (PLAN §5.1). Date.now() = ms epoch, matching Vector's ms unit.
#
# SHAPE: the pipeline id comes from the DIRECTORY name (stamp_agg/), so the
# conf body is the functions list directly, with NO `pipelines: <id>: conf:`
# wrapper.
{% if llt_role == 'agg_t1' %}
functions:
  - id: eval
    filter: "true"
    conf:
      add:
        - name: hop_ts.agg1
          value: Date.now()
{% else %}
functions:
  - id: eval
    filter: "true"
    conf:
      add:
        - name: hop_ts.agg2
          value: Date.now()
{% endif %}
groups: {}
