# {{ ansible_managed }}
# Cribl Edge outputs — scenario-selected destination (PARITY with Vector sink).
outputs:
{% if scenario in ['s1', 's2'] %}
  # ---- S1/S2: Webhook (HTTP NDJSON) to Tier-1 NLB :8080 (PLAN §4.4) ---------
  # CROSS-PAIRING (C10): target the CELL's aggregator (llt_t1_endpoint), NOT
  # unconditionally cribl_edge_agg_t1_nlb — this Edge agent may be running in
  # a Vector-aggregator cell (aggregator=vagg), in which case it must hit the
  # Vector tier-1 NLB instead.
  to_agg_t1:
    type: webhook
    url: "http://{{ llt_t1_endpoint }}:{{ cribl_edge_agg_t1_port }}"
    method: POST
    # LIVE-VERIFIED (Cribl 4.18.2): the Webhook destination `format` enum is
    # {ndjson, json_array, custom, advanced} — `json` is REJECTED ("should be
    # equal to one of the allowed values"). `ndjson` is newline-delimited JSON,
    # the exact parity match for Vector's framing.method: newline_delimited.
    # (The old "formats are json|raw" comment was wrong for this build.)
    format: ndjson
    # Keep egress near-real-time so the agent->T1 hop measures transport, not
    # buffering (mirrors Vector's 1s agent batch).
    # CONTROLLED CONSTANT — DO NOT CHANGE (PLAN §4.5/§4.6): this is the
    # agent-egress near-real-time flush, analogous to Vector's agent-side
    # batch.timeout_secs: 1 — not one of the §4.6 tuning knobs.
    flushPeriodSec: 1
    # compression NOT assessed (PLAN §5.4). TUNING §4.6 item 2 — explicitly
    # disabled. LIVE-VERIFIED (Cribl 4.18.2): the Webhook `compress` key is a
    # BOOLEAN — the string `none` is REJECTED ("should be boolean"); `false`
    # disables gzip. This is an ACTIVE tuning change on the Cribl side (Cribl's
    # own default is compression ON) to reach parity with Vector's
    # compression-off behavior, per the CPU-for-latency rationale (PLAN §4.6.2).
    compress: false
    # TUNING §4.6 item 2 — connection reuse/keep-alive: Cribl's Webhook
    # destination "Keep alive" is ON by default, holding the client-side
    # connection for up to 120 s (docs.cribl.io/stream/destinations-webhook/)
    # — kept at its default (nothing to change) but recorded explicitly here
    # since the tuning table needs a citable row. TODO(verify): could not
    # confirm the exact underlying JSON key name (UI label only, "Keep
    # alive") against the live 4.13 outputs.yml schema — NOT set explicitly
    # below to avoid guessing a wrong key that could be silently ignored or
    # reject the config; relying on the documented default instead.
    #
    # TUNING §4.6 item 2 — request concurrency allowed to scale: Cribl's
    # documented default is 5 (range 1-32); raised to
    # cribl_edge_concurrency (32, defaults/main.yml) — the parity
    # counterpart to Vector's adaptive concurrency (see docs/TUNING.md
    # parity ledger: Cribl's knob is a raised static ceiling, not a live-
    # adaptive algorithm — recorded as an asymmetry). TODO(verify): could
    # not confirm the exact underlying JSON key (UI label "Request
    # concurrency") against the live 4.13 schema — best-guess key name below
    # by analogy with Cribl's other REST-style destination concurrency
    # fields; verify against a live node and correct if rejected.
    concurrency: {{ cribl_edge_concurrency }}
    # TUNING §4.6 item 3 — buffer/backpressure: Persistent Queue is OFF by
    # default (must be explicitly selected as the Backpressure behavior;
    # docs.cribl.io/stream/persistent-queues-destinations/ +
    # destinations-backpressure-triggers/) — NOT enabling it here keeps this
    # hop's buffering in-memory only (no disk buffer on the measured path,
    # matching Vector's buffer.type: memory). Cribl's documented default
    # Backpressure behavior is Block (matches Vector's buffer.when_full:
    # block) — recorded explicitly (not set as a key below) because it is
    # already the wanted default and no PQ-enabling key is being added.
    tls:
      disabled: true        # TLS off on internal hops (PLAN §4.4)
{% else %}
  # ---- S3/S4: S3 destination to landing bucket, 5s flush/10MB (PLAN §4.5) ---
  # CROSS-PAIRING (C10): land in the CELL's landing bucket (llt_landing_bucket),
  # NOT unconditionally cribl_edge_landing_bucket — see rationale above.
  to_landing_s3:
    type: s3
    bucket: "{{ llt_landing_bucket }}"
    region: "{{ cribl_edge_aws_region }}"
    # LIVE-VERIFIED (Cribl 4.18.2): Cribl's S3 destination runs a startup
    # verifyAndGetBucketRegionV3 pre-flight (a HeadBucket/GetBucketLocation
    # probe) needing s3:ListBucket/s3:GetBucketLocation. The generator role is
    # s3:PutObject-ONLY on the cross-account landing bucket (least privilege;
    # terraform iam generator_s3 + s3-buckets landing policy grant PutObject
    # only). So the probe 403s and the destination logs "error initializing ...
    # Bucket does not exist - bucket access forbidden" (from
    # M.verifyAndGetBucketRegionV3) and never writes — even though runtime
    # PutObject works. `verifyPermissions: false` skips that pre-flight (Cribl
    # docs: "Disable if you can access files within the bucket but not the
    # bucket itself"). This is Cribl Edge's exact analogue of the Vector agent
    # aws_s3 `healthcheck: enabled: false` fix (commit 2012cc2); region is set
    # explicitly above so no bucket-region lookup is needed. Do NOT widen the
    # IAM grant to satisfy the probe.
    verifyPermissions: false
    # Key prefix carries run_id + host_os, identical scheme to the Vector aws_s3
    # sink (PLAN §5.1 host_os dimension). M7: destPath is a JS TEMPLATE LITERAL
    # in Cribl (backtick-delimited with ${...} interpolation), not a plain
    # string — "landing/{{ run_id }}/${host_os}" style concatenation without
    # backticks is inert text, not an interpolated expression. partitionExpr
    # is neutralized so Cribl's default date-based partitioning doesn't add an
    # extra date folder into the key — the key must be exactly
    # landing/{run_id}/{host_os}/<file>, matching Vector's key_prefix scheme.
    destPath: "`landing/{{ run_id }}/${host_os}`"
    partitionExpr: "''"
    # LIVE-VERIFIED (Cribl 4.18.2): unlike the Webhook destination, the S3
    # destination ACCEPTS format: json and compress: none (different enum) — no
    # schema error on either. Kept as-is.
    format: json
    # compress: none — PLAN §5.4 lists compression as NOT assessed; the S3
    # destination's own default is likewise no compression for this format.
    compress: none
    # LIVE-VERIFIED (Cribl 4.18.2): the S3 destination REQUIRES `stagePath` (the
    # local dir where objects are assembled before PutObject) — omitting it fails
    # schema validation ("should have required property 'stagePath'"). Use Cribl's
    # own state dir.
    stagePath: "$CRIBL_HOME/state/outputs/staging"
    # CONTROLLED CONSTANT (PLAN §4.5): 10 MB max — identical to the Vector aws_s3
    # sink max_bytes=10MB.
    maxFileSizeMB: 10
    # LIVE-VERIFIED (Cribl 4.18.2): the S3 destination enforces
    # maxFileOpenTimeSec >= 10 ("should be >= 10" at 5). So the Vector-parity 5 s
    # flush (batch.timeout_secs=5) CANNOT be honored on this knob — it is floored
    # to cribl_edge_s3_open_time_secs (10). Recorded as a §4.5 parity asymmetry in
    # docs/TUNING.md. maxFileIdleTimeSec has no such floor and stays at 5 s.
    maxFileOpenTimeSec: {{ cribl_edge_s3_open_time_secs }}
    maxFileIdleTimeSec: {{ cribl_edge_s3_flush_secs }}
    # TUNING §4.6 item 3 note: the S3 destination's local file staging (the
    # maxFileOpenTimeSec/maxFileIdleTimeSec-governed active file) is a
    # DIFFERENT mechanism from an in-memory event buffer (it is how Cribl's
    # S3 destination assembles an object to PutObject, not a queue that
    # could "block" or "drop"). There is no separate in-memory-vs-disk
    # buffer toggle to set on this destination type the way there is on
    # Webhook (Persistent Queue) — recorded in docs/TUNING.md as "no
    # additional buffer knob applicable to the S3 destination type."
{% endif %}
