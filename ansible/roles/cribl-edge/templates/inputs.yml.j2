# {{ ansible_managed }}
# Cribl Edge inputs — File Monitor on the generator output (PARITY with the
# Vector agent's `file` source; PLAN §5.2 gen->agent hop).
#
# LIVE-VERIFIED SCHEMA (Cribl Edge 4.18.2 on lin-ce). The whole prior config was
# rejected/ignored for two reasons that are now fixed:
#   (1) It was written to the wrong config group (local/cribl/ instead of
#       local/edge/) so a mode-edge worker never saw it — see cribl_edge_local_*
#       in defaults/main.yml.
#   (2) Even once loaded, the File Monitor schema differs from what was guessed:
#       - `mode: manual` requires a search DIRECTORY `path:` (absolute, no
#         wildcards) PLUS a `filenames:` allowlist of basenames within it — NOT
#         a full file path in `filenames:` (live error: "should have required
#         property 'path'").
#       - the polling-interval key is `interval` (integer seconds), NOT
#         `servicePeriodSecs` (packaged in_file_varlog uses `interval: 10`;
#         `servicePeriodSecs` silently loaded but is not the real key).
#       - `tailOnly: false` = read from the beginning of discovered files
#         (packaged defaults use `tailOnly: true`); this is the read-from-start
#         behavior we need.
#       - the built-in NDJSON event-breaker ruleset ID is `Cribl` (description:
#         "Event breaking rules for new line delimited json data"), NOT the UI
#         label "JSON Newline Delimited" (live warn: 'rulesets need creating:
#         ["JSON Newline Delimited"]'). `Cribl` resolves with no warning.
inputs:
  gen_file:
    type: file
    disabled: false
    # Route this source's events through the Routes/pipelines (default-off for
    # this input type on Edge would drop it) — required so the llt_main route
    # actually receives these events.
    sendToRoutes: true
    # mode: manual — deterministic discovery of a known directory (matches the
    # packaged in_file_varlog default's shape). `manual` requires `path` (dir)
    # + `filenames` (allowlist). We monitor the single generator output file.
    #
    # TUNING §4.6 item 1 — read-from-beginning DECISION (tailOnly: false):
    # identical rationale to vector-agent/templates/vector.yaml.j2's gen_file
    # source comment — eventgen.py's RotatingWriter truncates this file to empty
    # (mode="w") every time the generator process starts, and the orchestrator
    # starts the generator (harness/orchestrator/run_matrix.py execute_cell
    # phase 3) only AFTER this agent is already installed/running/watching (this
    # role's configure.yml only re-templates+restarts on scenario changes, never
    # starts the agent per-run). Read-from-start of a freshly-truncated file is
    # therefore latency-neutral vs. read-from-end — there is no stale data to
    # skip. See the Vector comment for the full chain of evidence.
    mode: manual
    path: "{{ cribl_edge_source_dir_win_fwd if ansible_os_family == 'Windows' else cribl_edge_source_dir_linux }}"
    # C11: forward slashes only on Windows — this path is rendered into config
    # CONTENT, not consumed by a win_* module; backslashes inside the
    # double-quoted scalar produce illegal escapes and Cribl's config loader
    # rejects the file. filenames = basename allowlist WITHIN `path`.
    filenames:
      - "{{ cribl_edge_source_file }}"
    tailOnly: false
    idleTimeout: 30
    # TUNING §4.6 item 1 — poll interval floored to cribl_edge_poll_interval_secs
    # (1 s, defaults/main.yml), the parity counterpart to Vector's
    # glob_minimum_cooldown_ms floor. VERIFIED key name is `interval` (seconds).
    interval: {{ cribl_edge_poll_interval_secs }}
    # M6: assign the built-in NDJSON event-breaker ruleset (`Cribl`) so each line
    # is parsed into an event with TOP-LEVEL run_id/seq/host_id/host_os/t_gen_ns/
    # hop_ts fields (analyze.py reads top-level fields). Without an explicit
    # JSON breaker, Cribl's default breaker leaves the whole line in _raw and the
    # Eval in pipelines/stamp_agent can't see .hop_ts on the object. The `Cribl`
    # ruleset is type:json, breaks on newlines — the parity counterpart to
    # Vector's newline-delimited JSON decoding.
    breakerRulesets:
      - "Cribl"
