# {{ ansible_managed }}
# Cribl worker route — group {{ cribl_worker_group }}, scenario {{ scenario }}.
# Wire all sources through stamp_agg to the scenario destination (mirrors the
# Vector aggregator input->transform->sink wiring).
routes:
  routes:
    - name: llt_main
      filter: "true"
      pipeline: stamp_agg
{% if cribl_worker_group == 't1' and scenario in ['s2', 's4'] %}
      output: to_t2
{% else %}
      output: final_s3
{% endif %}
      final: true
