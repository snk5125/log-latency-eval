# {{ ansible_managed }}
# Cribl worker-group route — group {{ _group }}, scenario {{ scenario }}.
# C5: templated and committed/deployed FROM THE LEADER — see inputs.yml.j2 note.
# Wire all sources through stamp_agg to the scenario destination (mirrors the
# Vector aggregator input->transform->sink wiring).
#
# C4 SHAPE: top-level `routes:` is a LIST (not a dict wrapping a second
# `routes:` key) — each entry is {id, name, filter, pipeline, output, final}.
routes:
  - id: llt_main
    name: llt_main
    filter: "true"
    pipeline: stamp_agg
{% if _group == 't1' and scenario in ['s2', 's4'] %}
    output: to_t2
{% else %}
    output: final_s3
{% endif %}
    final: true
