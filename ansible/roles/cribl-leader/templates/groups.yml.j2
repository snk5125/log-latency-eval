# {{ ansible_managed }}
# Cribl Stream worker-group definitions (PLAN §4.3). Workers self-assign to a
# group by tag when they join (see cribl-worker role). Groups: t1 (tier-1) and
# t2 (tier-2), matching the Vector aggregator two-tier topology for parity.
groups:
{% for g in cribl_worker_groups %}
  {{ g }}:
    description: "llt worker group {{ g }}"
    # Config bundle for each group is delivered by the cribl-worker role, which
    # mirrors the vector-aggregator source/eval/destination logic per tier.
    #
    # TUNING §4.6 item 5 — Cribl worker processes set to vCPU count. Every
    # group's workers run on m6i.xlarge (4 vCPU, PLAN §4.3); set to
    # cribl_worker_processes (4, defaults/main.yml) so each worker node runs
    # exactly 4 worker processes (one per vCPU), maximizing parallelism.
    # docs.cribl.io/stream/scaling/ documents "Worker Processes" as a
    # Group Settings field where a POSITIVE integer is an exact process
    # count (vs. the documented DEFAULT of -2, meaning vCPU-count-minus-2 —
    # only 2 processes on a 4-vCPU node, which is why this is an ACTIVE
    # tuning change, not a kept-default). Parity counterpart to Vector's
    # "defaults to all cores" (recorded — no equivalent knob needed on the
    # Vector side since it already uses every core with no artificial cap;
    # see vector-aggregator/templates/vector.service.j2 comment).
    #
    # TODO(verify): the exact underlying persisted key for this UI-facing
    # "Worker Processes" Group Setting was NOT confirmed against a live
    # 4.13 groups.yml — Cribl's docs describe the UI location (Worker
    # Groups > <group> > Group Settings > Worker Processes,
    # docs.cribl.io/stream/scaling/) but did not expose the on-disk
    # key/file for that specific per-group override in the pages checked. A
    # DIFFERENT, node-level setting IS documented precisely:
    # $CRIBL_HOME/local/cribl/cribl.yml's `workers: count:` key (schema
    # comment: "default: 1; if less than 1 the value is added to CPU
    # count" — docs.cribl.io/stream/criblyml/), which is a NODE config, not
    # a per-Group leader-managed override, and this repo's leader-managed
    # distributed mode (C5) means node-local writes on the WORKER are not
    # the right place for this (would need per-node cribl.yml templating
    # outside the group-config-push model this role already uses for
    # inputs/outputs/pipelines/route — a change of that shape is not made
    # here since it is not one of the config surfaces §4.6 scopes this task
    # to). `workerProcesses` (used below, by analogy with the confirmed
    # groups.yml key `workerRemoteAccess` — both are per-group boolean/
    # numeric settings persisted at this same nesting level per Cribl's
    # worker-groups documentation, docs.cribl.io/stream/worker-groups/) is
    # the best-effort key name; if Cribl silently ignores it, the accurate
    # constraint recorded in docs/TUNING.md is: no confirmed leader-pushed
    # per-group key was found for this setting, and cribl.yml's
    # node-level workers.count (default 1, discrepant with the Group
    # Settings UI's documented default of -2) is left as a further-work
    # verification item rather than guessed into a shape this role does
    # not otherwise use.
    workerProcesses: {{ cribl_worker_processes }}
{% endfor %}
