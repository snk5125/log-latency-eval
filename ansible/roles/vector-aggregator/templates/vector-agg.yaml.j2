# {{ ansible_managed }}
# =============================================================================
# Vector AGGREGATOR config — llt latency experiment
# tier: {{ llt_role }}  |  scenario: {{ scenario }}  |  host: {{ inventory_hostname }}
# =============================================================================
# PARITY CONTRACT (must match cribl-stream role exactly):
#   Tier-1 sources: http :8080 (S1/S2/S3/S4) + aws_s3 via SQS (S3/S4 only)
#   Tier-1 remap  : add hop_ts.agg1 (ms epoch)
#   Tier-1 sink   : S1/S3 -> final S3 (5s/10MB, key final/{run_id}/{host_os}/)
#                   S2/S4 -> http :8081 to Tier-2 NLB (1s batch)
#   Tier-2 source : http :8081
#   Tier-2 remap  : add hop_ts.agg2 (ms epoch)
#   Tier-2 sink   : final S3 (5s/10MB)
# Field names hop_ts.agg1 / hop_ts.agg2 are LOAD-BEARING (PLAN §5.1).
# =============================================================================

data_dir: /var/lib/vector

sources:
{% if llt_role == 'agg_t1' %}
  # ---- TIER-1 HTTP source :8080 (all scenarios receive agent HTTP here for
  #      S1/S2; for S3/S4 the agent went to S3 instead, but the listener is
  #      harmless and kept for config uniformity). PLAN §4.4.
  http_in:
    type: http_server
    address: "0.0.0.0:{{ vector_t1_http_port }}"
    encoding: ndjson          # newline-delimited JSON bodies (PLAN §4.4)
    path: "/"
{% if scenario in ['s3', 's4'] %}
  # ---- TIER-1 S3 source via SQS — ENABLED ONLY in S3/S4 (PLAN §4.3 event-
  #      driven pickup from the landing bucket). agent wrote to landing S3; this
  #      consumes those objects.
  s3_in:
    type: aws_s3
    region: "{{ vector_aws_region }}"
    sqs:
      queue_url: "{{ vector_landing_sqs_url }}"
      # Event-notification driven (not poll-interval) — PLAN §4.3.
      # TUNING §4.6 item 4 — long-poll wait floored to 20 s
      # (vector_sqs_poll_secs, defaults/main.yml). `sqs.poll_secs` is
      # Vector's own name for the SQS ReceiveMessage long-poll wait
      # parameter (there is no differently-named "wait_time_seconds" key in
      # 0.49); 20 s is AWS SQS's own hard ceiling for long-poll wait, so this
      # is the maximally event-driven (fewest empty-poll round trips)
      # setting available, up from Vector's 15 s default. Visibility timeout
      # is left at Vector's default (300 s) — S3 event notifications are
      # deleted from the queue immediately on successful consumption
      # (sqs.delete_message default true), so visibility timeout does not
      # sit on the measured latency path. Vendor doc:
      # https://vector.dev/docs/reference/configuration/sources/aws_s3/
      # (sqs.poll_secs default 15).
      poll_secs: {{ vector_sqs_poll_secs }}
    # Landing objects are NDJSON. aws_s3's default framing IS
    # newline-delimited, but the source does NOT JSON-decode by default (it
    # yields raw string lines) — without an explicit decoding codec every
    # object here is dropped/mis-parsed downstream (C3 fix). Declare both
    # explicitly so behavior doesn't depend on the framing default.
    framing:
      method: newline_delimited
    decoding:
      codec: json
{% endif %}
{% elif llt_role == 'agg_t2' %}
  # ---- TIER-2 HTTP source :8081 (receives tier-1 forward in S2/S4). PLAN §4.4.
  http_in:
    type: http_server
    address: "0.0.0.0:{{ vector_t2_http_port }}"
    encoding: ndjson
    path: "/"
{% endif %}

transforms:
{% if llt_role == 'agg_t1' %}
  # Stamp hop_ts.agg1 on tier-1 (PLAN §5.1). ms epoch to match Cribl Eval.
  stamp_agg1:
    type: remap
{% if scenario in ['s3', 's4'] %}
    inputs: [http_in, s3_in]
{% else %}
    inputs: [http_in]
{% endif %}
    source: |
      if !exists(.hop_ts) { .hop_ts = {} }
      .hop_ts.agg1 = to_unix_timestamp(now(), unit: "milliseconds")
{% elif llt_role == 'agg_t2' %}
  # Stamp hop_ts.agg2 on tier-2 (PLAN §5.1).
  stamp_agg2:
    type: remap
    inputs: [http_in]
    source: |
      if !exists(.hop_ts) { .hop_ts = {} }
      .hop_ts.agg2 = to_unix_timestamp(now(), unit: "milliseconds")
{% endif %}

sinks:
{% if llt_role == 'agg_t1' %}
{% if scenario in ['s1', 's3'] %}
  # ---- S1/S3: tier-1 is TERMINAL -> final S3 (5s/10MB). PLAN §4.5 + key scheme
  #      final/{run_id}/{host_os}/ (PLAN §5.1 host_os partition). host_os is a
  #      per-EVENT field, so we partition by the event's host_os value.
  final_s3:
    type: aws_s3
    inputs: [stamp_agg1]
    bucket: "{{ vector_final_bucket }}"
    region: "{{ vector_aws_region }}"
    key_prefix: "final/{{ run_id }}/{{ '{{' }} .host_os {{ '}}' }}/"
    # no compression — also Vector's documented default (TUNING §4.6 item 2
    # CPU-for-latency rationale): https://vector.dev/docs/reference/
    # configuration/sinks/aws_s3/
    compression: none
    encoding:
      codec: json
    framing:
      method: newline_delimited
    # TUNING §4.6 item 3 — in-memory buffer, BLOCK on overflow, sized for
    # 10k EPS (vector_buffer_max_events, defaults/main.yml). Same
    # rationale/citation as vector-agent's sinks.
    buffer:
      type: memory
      max_events: {{ vector_buffer_max_events }}
      when_full: block
    batch:
      # CONTROLLED CONSTANT — DO NOT CHANGE (PLAN §4.5/§4.6).
      timeout_secs: {{ vector_s3_batch_timeout_secs }}
      max_bytes: {{ vector_s3_batch_max_bytes }}
{% else %}
  # ---- S2/S4: tier-1 forwards HTTP NDJSON to Tier-2 NLB :8081 (1s batch).
  to_t2:
    type: http
    inputs: [stamp_agg1]
    uri: "http://{{ vector_agg_t2_nlb }}:{{ vector_t2_http_port }}"
    method: post
    # TUNING §4.6 item 2 — compression DISABLED (also Vector's documented
    # default). Vendor doc: https://vector.dev/docs/reference/configuration/
    # sinks/http/
    compression: none
    encoding:
      codec: json
    framing:
      method: newline_delimited
    request:
      # TUNING §4.6 item 2 — adaptive concurrency + non-inflating retry
      # backoff, same rationale/citation as vector-agent's to_agg_t1 sink
      # (also Vector's documented defaults in 0.49).
      concurrency: adaptive
      retry_initial_backoff_secs: 1
      retry_max_duration_secs: 30
    # TUNING §4.6 item 2 — connection reuse/keep-alive: no explicit Vector
    # HTTP-sink config key exists (see vector-agent/templates/vector.yaml.j2
    # to_agg_t1 sink comment for the full parity-ledger rationale — this is
    # the T1->T2 inter-tier hop's instance of the same "no equivalent knob"
    # item).
    #
    # TUNING §4.6 item 3 — in-memory buffer, BLOCK on overflow, sized for
    # 10k EPS.
    buffer:
      type: memory
      max_events: {{ vector_buffer_max_events }}
      when_full: block
    batch:
      # CONTROLLED CONSTANT — DO NOT CHANGE (PLAN §4.5/§4.6): inter-tier
      # HTTP batch timeout stays at 1 s; §4.6 tunes concurrency/keepalive/
      # compression only, never batch timeout/size.
      timeout_secs: {{ vector_http_batch_timeout_secs }}   # 1 s inter-tier (§4.5)
    healthcheck:
      enabled: false
{% endif %}
{% elif llt_role == 'agg_t2' %}
  # ---- Tier-2 is always TERMINAL -> final S3 (5s/10MB). PLAN §4.5.
  final_s3:
    type: aws_s3
    inputs: [stamp_agg2]
    bucket: "{{ vector_final_bucket }}"
    region: "{{ vector_aws_region }}"
    key_prefix: "final/{{ run_id }}/{{ '{{' }} .host_os {{ '}}' }}/"
    # no compression — also Vector's documented default (TUNING §4.6 item 2
    # CPU-for-latency rationale): https://vector.dev/docs/reference/
    # configuration/sinks/aws_s3/
    compression: none
    encoding:
      codec: json
    framing:
      method: newline_delimited
    # TUNING §4.6 item 3 — in-memory buffer, BLOCK on overflow, sized for
    # 10k EPS.
    buffer:
      type: memory
      max_events: {{ vector_buffer_max_events }}
      when_full: block
    batch:
      # CONTROLLED CONSTANT — DO NOT CHANGE (PLAN §4.5/§4.6).
      timeout_secs: {{ vector_s3_batch_timeout_secs }}
      max_bytes: {{ vector_s3_batch_max_bytes }}
{% endif %}
